---
import { Image } from "astro:assets";
import Icon from "../Icon.astro";
import MentorshipBadge from "./MentorshipBadge.astro";

const { research, as: Element = "div" } = Astro.props;

const getIcon = (key: string) => {
  const lowerKey = key.toLowerCase();
  if (lowerKey.includes("arxiv")) return "arxiv";
  if (lowerKey.includes("code") || lowerKey.includes("github")) return "github";
  if (lowerKey.includes("pdf")) return "pdf";
  if (lowerKey.includes("paper") || lowerKey.includes("publication"))
    return "paper";
  if (lowerKey.includes("video") || lowerKey.includes("demo")) return "video";
  if (lowerKey.includes("website") || lowerKey.includes("site"))
    return "website";
  if (lowerKey.includes("overview") || lowerKey.includes("project"))
    return "link";
  if (lowerKey.includes("slides")) return "slides";
  if (lowerKey.includes("poster")) return "poster";
  if (lowerKey.includes("dataset") || lowerKey.includes("huggingface"))
    return "dataset";
  return "link";
};

const getIconTitle = (key: string) => {
  const lowerKey = key.toLowerCase();
  if (lowerKey.includes("arxiv")) return "arXiv";
  if (lowerKey.includes("code") || lowerKey.includes("github")) return "Code";
  if (lowerKey.includes("pdf")) return "PDF";
  if (lowerKey.includes("paper") || lowerKey.includes("publication"))
    return "Paper";
  if (lowerKey.includes("video") || lowerKey.includes("demo")) return "Video";
  if (lowerKey.includes("website") || lowerKey.includes("site"))
    return "Website";
  if (lowerKey.includes("overview") || lowerKey.includes("project"))
    return "Project";
  if (lowerKey.includes("slides")) return "Slides";
  if (lowerKey.includes("poster")) return "Poster";
  if (lowerKey.includes("dataset") || lowerKey.includes("huggingface"))
    return "Dataset";
  return key;
};

const paperLink =
  (Object.entries(research.data.links).find(
    ([key]) =>
      key.toLowerCase().includes("paper") ||
      key.toLowerCase().includes("publication"),
  )?.[1] as string) || `/research/${research.id}`;

const categoryConfig: Record<string, { label: string; style: string }> = {
  preprint: {
    label: "Preprint",
    style:
      "bg-rose-100/80 text-rose-600/90 dark:bg-rose-500/10 dark:text-rose-400/80",
  },
  conference: {
    label: "Conference",
    style:
      "bg-indigo-100/80 text-indigo-600/90 dark:bg-indigo-500/10 dark:text-indigo-400/80",
  },
  journal: {
    label: "Journal",
    style:
      "bg-teal-100/80 text-teal-700/90 dark:bg-teal-500/10 dark:text-teal-400/80",
  },
  workshop: {
    label: "Workshop",
    style:
      "bg-orange-100/80 text-orange-600/90 dark:bg-orange-500/10 dark:text-orange-400/80",
  },
};

const category = research.data.category;
const catCfg = category ? categoryConfig[category] : null;
const year = new Date(research.data.publishDate).getFullYear();
const venue = research.data.venue;
const venueFull = research.data.venue_full;
const tldr = research.data.tldr;
---
<Element class="research-card">
  <div class="research-figure">
    <button type="button" class="img-preview-btn" aria-label={`Enlarge figure for ${research.data.title}`}
      data-src={typeof research.data.feature === "string" ? research.data.feature : research.data.feature.src}
      data-alt={research.data.title}>
      <Image src={research.data.feature} alt={research.data.title} height={200} width={260} loading="lazy" />
    </button>
  </div>
  <div class="research-body">
    <div class="research-meta">
      {catCfg && <span class={`paper-category ${catCfg.style}`}>{catCfg.label}</span>}
      <span title={venueFull} class="paper-venue">{venue}</span>
      <span class="paper-year">{year}</span>
      <MentorshipBadge mentees={research.data.mentored ?? []} />
    </div>
    <a class="paper-title" href={paperLink} target={paperLink.startsWith("/") ? "_self" : "_blank"}
      rel={paperLink.startsWith("/") ? undefined : "noopener noreferrer"}>
      <h2>{research.data.title}</h2>
    </a>
    {tldr && <p class="paper-summary"><span>TL;DR</span> {tldr}</p>}
    <p class="paper-authors">
      {research.data.authors.map((author: string, idx: number) => (
        <><span class={idx === research.data.author_idx ? "paper-self" : undefined}>{author}</span>{idx < research.data.authors.length - 1 ? ", " : ""}</>
      ))}
    </p>
    <div class="paper-topics">{(research.data.tags ?? []).map((tag: string) => <span>{tag}</span>)}</div>
    <div class="paper-links">
      {Object.entries(research.data.links).map(([key, value]) => {
        const url = value as string;
        return <a href={url} target={url.startsWith("/") ? "_self" : "_blank"}
          rel={url.startsWith("/") ? undefined : "noopener noreferrer"}>
          <Icon name={getIcon(key)} class="h-3.5 w-3.5" /><span>{getIconTitle(key)}</span>
        </a>;
      })}
    </div>
  </div>
</Element>

<style>
  .research-card { display:grid; grid-template-columns:184px minmax(0,1fr); gap:28px; padding:8px 0 30px; border-bottom:1px solid color-mix(in srgb, var(--surface-border) 65%, transparent); }
  .research-figure { align-self:start; padding-top:4px; }
  .img-preview-btn { display:flex; align-items:center; justify-content:center; width:100%; min-height:130px; border-radius:10px; overflow:hidden; cursor:zoom-in; background:var(--figure-bg); border:1px solid var(--surface-border); }
  .img-preview-btn :global(img) { width:100%; height:auto; max-height:190px; object-fit:contain; }
  .research-body { min-width:0; }
  .research-meta { display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:10px; font-size:12px; }
  .paper-category { border-radius:4px; padding:3px 6px; font-weight:600; }
  .paper-venue { font-weight:600; color:var(--theme-accent); }
  .paper-year { color:var(--muted-text); }
  .paper-title h2 { font-size:19px; line-height:1.4; font-weight:650; letter-spacing:-.025em; color:var(--theme-text); }
  .paper-title:hover h2 { color:var(--theme-accent); }
  .paper-summary { margin-top:12px; font-size:14px; line-height:1.7; color:var(--body-text); }
  .paper-summary > span { font-size:10px; font-weight:700; letter-spacing:.07em; color:var(--theme-accent); margin-right:5px; }
  .paper-authors { margin-top:12px; font-size:12px; line-height:1.75; color:var(--muted-text); }
  .paper-self { font-weight:650; color:var(--body-text); }
  .paper-topics { display:flex; flex-wrap:wrap; gap:5px 12px; margin-top:10px; color:var(--muted-text); font-size:11px; }
  .paper-links { display:flex; flex-wrap:wrap; gap:7px; margin-top:15px; }
  .paper-links a { display:inline-flex; align-items:center; gap:6px; padding:5px 9px; font-size:12px; font-weight:550; border:1px solid var(--surface-border); border-radius:6px; color:var(--body-text); }
  .paper-links a:hover { background:var(--theme-accent); color:var(--theme-bg); border-color:var(--theme-accent); }
  @media (max-width:700px) {
    .research-card { grid-template-columns:1fr; gap:18px; padding:4px 0 26px; }
    .research-figure { padding:0; }
    .img-preview-btn { height:155px; }
    .img-preview-btn :global(img) { width:auto; max-width:100%; max-height:155px; }
    .paper-title h2 { font-size:18px; }
  }
</style>
<script>
  // Create a single global lightbox on first use
  function getOrCreateLightbox() {
    let lb = document.getElementById("global-img-lightbox");
    if (lb) return lb;

    lb = document.createElement("div");
    lb.id = "global-img-lightbox";
    lb.style.cssText = [
      "display:none",
      "position:fixed",
      "inset:0",
      "z-index:9999",
      "background:rgba(0,0,0,0.75)",
      "backdrop-filter:blur(4px)",
      "align-items:center",
      "justify-content:center",
      "padding:1rem",
    ].join(";");

    lb.innerHTML = `
			<div style="position:relative;max-width:56rem;width:100%">
				<img id="lightbox-img" style="width:100%;border-radius:0.75rem;box-shadow:0 25px 50px rgba(0,0,0,0.5);object-fit:contain;max-height:80vh" src="" alt="" />
				<button id="lightbox-close" aria-label="Close image preview" style="position:absolute;top:-0.75rem;right:-0.75rem;display:flex;align-items:center;justify-content:center;width:2rem;height:2rem;border-radius:9999px;background:rgba(255,255,255,0.95);color:#1f2937;border:none;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,0.3)">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
				</button>
			</div>`;

    document.body.appendChild(lb);

    const close = () => {
      lb!.style.display = "none";
      document.body.style.overflow = "";
    };
    document.getElementById("lightbox-close")!.addEventListener("click", close);
    lb.addEventListener("click", (e) => {
      if (e.target === lb) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });

    return lb;
  }

  document
    .querySelectorAll<HTMLButtonElement>(".img-preview-btn")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const lb = getOrCreateLightbox();
        const img = document.getElementById("lightbox-img") as HTMLImageElement;
        img.src = btn.dataset.src ?? "";
        img.alt = btn.dataset.alt ?? "";
        lb.style.display = "flex";
        document.body.style.overflow = "hidden";
      });
    });
</script>
