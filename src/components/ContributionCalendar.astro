---
import data from "../data/github-contributions.json";
import { calendarLayout } from "../../scripts/lib/github-contributions.mjs";

const { cells, weeks, months } = calendarLayout(data.days);
const formatDate = (date: string) => new Date(date).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<section class="contribution-section" aria-label="GitHub activity">
  <div class="calendar-panel">
    <div class="calendar-scroll" role="region" aria-label="Contribution calendar; scroll horizontally on small screens" tabindex="0">
      <div class="calendar-content" style={`--weeks:${weeks}`}>
        <div class="months" aria-hidden="true">{months.map((month) => <span style={`grid-row:1;grid-column:${month.column} / span ${Math.min(3, weeks - month.column + 1)}`}>{month.label}</span>)}</div>
        <div class="calendar-row">
          <div class="weekdays" aria-hidden="true"><span>Mon</span><span>Wed</span><span>Fri</span></div>
          <div class="day-grid" aria-label="Daily contributions. Use arrow keys to explore." role="group">
            {cells.map((day) => day ? <button type="button" class={`day level-${day.level}`}
              tabindex={day.date === data.days.at(-1)!.date ? 0 : -1}
              data-detail={`${day.count.toLocaleString("en-US")} contribution${day.count === 1 ? "" : "s"} on ${formatDate(day.date)}`}
              aria-label={`${day.count} contribution${day.count === 1 ? "" : "s"} on ${formatDate(day.date)}`}
              title={`${day.count} contribution${day.count === 1 ? "" : "s"} on ${formatDate(day.date)}`} /> : <span aria-hidden="true" />)}
          </div>
        </div>
      </div>
    </div>
    <div class="calendar-footer">
      <p class="day-detail" aria-live="polite"></p>
      <div class="calendar-legend" aria-label="Contribution intensity, less to more"><span>Less</span>{[0,1,2,3,4].map((level) => <i class={`level-${level}`} aria-hidden="true" />)}<span>More</span></div>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>(".calendar-panel").forEach((panel) => {
    const days = [...panel.querySelectorAll<HTMLButtonElement>(".day")];
    const output = panel.querySelector<HTMLElement>(".day-detail")!;
    const select = (day: HTMLButtonElement) => {
      output.textContent = day.dataset.detail ?? "";
      days.forEach((item) => item.tabIndex = item === day ? 0 : -1);
    };
    days.forEach((day, index) => {
      day.addEventListener("pointerenter", () => select(day));
      day.addEventListener("focus", () => select(day));
      day.addEventListener("click", () => select(day));
      day.addEventListener("keydown", (event) => {
        const offsets: Record<string, number> = { ArrowLeft: -7, ArrowRight: 7, ArrowUp: -1, ArrowDown: 1 };
        if (!(event.key in offsets) && event.key !== "Home" && event.key !== "End") return;
        event.preventDefault();
        const next = event.key === "Home" ? 0 : event.key === "End" ? days.length - 1 : Math.max(0, Math.min(days.length - 1, index + offsets[event.key]));
        days[next].focus();
      });
    });
  });
</script>
<style>
  .contribution-section { margin-top:36px; }
  .calendar-panel { padding:20px 0 0; border-top:1px solid color-mix(in srgb, var(--surface-border) 65%, transparent); }
  .calendar-scroll { overflow-x:auto; padding:4px; margin:-4px; scrollbar-width:thin; }
  .calendar-content { min-width:620px; }
  .months { display:grid; grid-template-columns:repeat(var(--weeks),minmax(0,1fr)); margin-left:34px; gap:3px; height:22px; color:var(--muted-text); font-size:10px; }
  .calendar-row { display:flex; gap:8px; }
  .weekdays { width:26px; flex-shrink:0; display:grid; grid-template-rows:repeat(7,1fr); font-size:9px; color:var(--muted-text); }
  .weekdays span:nth-child(1) { grid-row:2; } .weekdays span:nth-child(2) { grid-row:4; } .weekdays span:nth-child(3) { grid-row:6; }
  .day-grid { flex:1; display:grid; grid-template-columns:repeat(var(--weeks),minmax(0,1fr)); grid-template-rows:repeat(7,1fr); grid-auto-flow:column; gap:3px; }
  .day { width:100%; aspect-ratio:1; border-radius:3px; border:1px solid transparent; cursor:pointer; }
  .day:hover, .day:focus-visible { outline:2px solid var(--theme-text); outline-offset:1px; }
  .level-0 { background:var(--heat-0); } .level-1 { background:var(--heat-1); } .level-2 { background:var(--heat-2); } .level-3 { background:var(--heat-3); } .level-4 { background:var(--heat-4); }
  .calendar-footer { display:flex; flex-wrap:wrap; justify-content:space-between; gap:12px; margin-top:12px; font-size:11px; color:var(--muted-text); }
  .calendar-legend { display:flex; gap:4px; align-items:center; }
  .calendar-legend i { display:block; width:10px; height:10px; border-radius:2px; }
  .calendar-legend span { margin:0 4px; }
</style>
