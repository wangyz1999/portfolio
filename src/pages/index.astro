---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base";
import ResearchPreview from "@/components/research/ResearchPreview";
import { selectedResearch } from "@/utils";
import InLineLink from "@/components/InLineLink";
import ContributionCalendar from "@/components/ContributionCalendar";

const allResearch = await getCollection("research");
const selected = selectedResearch(allResearch);
---

<PageLayout meta={{ title: "Home" }}>
  <section class="intro">
    <p class="mb-3 text-base">
      I am a third-year Computer Science PhD student at USC, working with <InLineLink
        href="https://scholar.google.com/citations?user=fmqi35EAAAAJ"
        text="Volkan Ustun"
      />, <InLineLink
        href="https://ict.usc.edu/about-us/leadership/senior-management/william-swartout/"
        text="William Swartout"
      />, <InLineLink
        href="https://scholar.google.com/citations?user=Bkq-JK8AAAAJ"
        text="Gale Lucas"
      />, and <InLineLink
        href="https://scholar.google.com/citations?user=9REqw58AAAAJ"
        text="Burcin Becerik-Gerber"
      />. In summer 2026, I was an Applied Scientist Intern at <InLineLink
        href="https://aws.amazon.com/"
        text="Amazon"
      />, working with <InLineLink href="https://ppengtang.github.io/" text="Peng Tang" /> on scalable mixed user–agent co-learning with the Amazon Quick
      team in the Agentic AI organization.
    </p>
    <p class="mb-3 text-base">Previously, I
      worked as a Software Engineer at <InLineLink
        href="https://bubble.io/"
        text="Bubble.io"
      />, building LLM agents for no-code web development, and conducted
      research in robot learning at Columbia University's <InLineLink
        href="https://www.creativemachineslab.com/"
        text="Creative Machines Lab"
      /> with <InLineLink
        href="https://www.hodlipson.com/"
        text="Hod Lipson"
      />.
    </p>
    <p class="mb-3 text-base">
      My research goal is to create physically and socially grounded AI agents
      that learn from and collaborate with humans in both physical and simulated
      environments. I am currently particularly interested in:
    </p>
    <ul class="research-interests">
      <li class="pl-2">
        <b>Multi-Agent Interaction</b> modeling and enabling mixed interactions
        among humans, robots, and AI agents in teaming, collaboration, and
        cooperative/competitive settings.
      </li>
      <li class="pl-2">
        <b>Realistic Human Simulation</b> generating individualized and
        crowd-level human behaviors with behavioral realism and social awareness
        for simulation, game NPCs, and training environments.
      </li>
      <li class="pl-2">
        <b>Agent Embodiment</b> building agents that interact with the physical
        world through first-person perception, robotic control, and sequential
        decision-making.
      </li>
    </ul>
  </section>

  <section class="mt-10 sm:mt-16">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="text-xxl title">Selected Work</h2>
      <a
        href="/research"
        class="text-sm text-accent hover:underline dark:text-accent-2"
      >
        Full research list →
      </a>
    </div>
    <ul class="space-y-6">
      {
        selected.map((p: any) => (
          <li>
            <ResearchPreview research={p} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10 sm:mt-16">
    <h2 class="text-xxl title mb-4">Research community</h2>
    <h3 class="text-md mb-2 font-semibold">
      Technical Program Committee (TPC) Member/Reviewer
    </h3>
    <ul class="service-list">
      <li class="pl-2">
        International Conference on Learning Representations (ICLR) 2024, 2025, 2026
      </li>
      <li class="pl-2">
        Association for the Advancement of Artificial Intelligence (AAAI) 2024,
        2025, 2026
      </li>
      <li class="pl-2">
        Conference on Empirical Methods in Natural Language Processing (EMNLP)
        2025
      </li>
      <li class="pl-2">
        International Conference on Autonomous Agents and Multiagent Systems
        (AAMAS) 2025, 2026
      </li>
      <li class="pl-2">
        International Conference on Machine Learning (ICML) 2026
      </li>
      <li class="pl-2">
        Conference on Neural Information Processing Systems (NeurIPS) 2026
      </li>
    </ul>
  </section>

  <ContributionCalendar />
</PageLayout>

<style>
  .intro > p { font-size:15px; line-height:1.85; color:var(--body-text); }
  .research-interests { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:22px; }
  .research-interests li { padding:17px; border-top:2px solid var(--surface-border); font-size:13px; line-height:1.7; color:var(--muted-text); }
  .research-interests b { display:block; margin-bottom:6px; color:var(--theme-text); font-size:14px; font-weight:650; }
  .service-list { list-style:disc; padding-left:22px; color:var(--body-text); font-size:14px; line-height:1.8; }
  .service-list li { padding:3px 0 3px 4px; }
  @media(max-width:700px) { .research-interests { grid-template-columns:1fr; } .research-interests { gap:0; } .research-interests li { padding:14px 0; } }
</style>
