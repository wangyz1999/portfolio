---
import type { CollectionEntry } from "astro:content";

import BaseLayout from "./Base.astro";
import MentorshipBadge from "@/components/research/MentorshipBadge";

interface Props {
	post: CollectionEntry<"research">;
}

const { post } = Astro.props;
const {
	data: { title, description },
} = post;
---

<BaseLayout meta={{ title, description }}>
	<div class="gap-x-10 lg:flex lg:items-start">
		<article class="flex-grow break-words">
      {post.data.mentored.length > 0 && (
        <div class="mt-6 space-y-2">
          <MentorshipBadge mentees={post.data.mentored} />
          <p class="text-sm text-textColor/70">I mentored {post.data.mentored.join(" and ")} on this work.</p>
        </div>
      )}
			<div
				class="prose-sm prose-cactus mt-12 prose-headings:font-semibold prose-headings:before:absolute prose-headings:before:-ms-4 prose-headings:before:text-accent prose-headings:before:content-['#'] prose-th:before:content-none"
			>
				<slot />
			</div>
		</article>
	</div>
</BaseLayout>
